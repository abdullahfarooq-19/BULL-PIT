# Bull Pit environment variables. Copy this file to .env and fill in real
# values there. .env is git-ignored; never commit real secrets.

# --- Alpaca paper trading -----------------------------------------------
# Must be exactly https://paper-api.alpaca.markets (the SDK adds /v2 itself).
# The trading client refuses to start with any other URL (bullpit/broker/safety.py).
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Groq (read by LiteLLM) ----------------------------------------------
GROQ_API_KEY=

# --- SEC EDGAR -------------------------------------------------------------
# Used in the User-Agent header SEC requires: "BullPit/<version> <email>".
# A dedicated project email is fine.
SEC_CONTACT_EMAIL=

# --- Pinned LLM models (D9 in dev-plan.md; don't change without an ADR) ---
LLM_SMALL_MODEL=openai/gpt-oss-20b
LLM_LARGE_MODEL=openai/gpt-oss-120b

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Misc --------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10.0
