# Bull Pit environment variables. Copy this file to .env and fill in real
# values there. .env is git-ignored; never commit real secrets.

# --- Alpaca paper trading -----------------------------------------------
# Must be exactly https://paper-api.alpaca.markets (the SDK adds /v2 itself).
# The trading client refuses to start with any other URL (bullpit/broker/safety.py).
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Groq (read by LiteLLM) ----------------------------------------------
GROQ_API_KEY=

# --- SEC EDGAR -------------------------------------------------------------
# Used in the User-Agent header SEC requires: "BullPit/<version> <email>".
# A dedicated project email is fine.
SEC_CONTACT_EMAIL=
SEC_MAX_REQUESTS_PER_SECOND=10.0

# --- Data layer --------------------------------------------------------
DATA_CACHE_DIR=data_cache
NEWS_LOOKBACK_DAYS=7

# --- Request check and analysts (M3) --------------------------------------
MIN_PRICE_SESSIONS=60
PRICE_HISTORY_SESSIONS=300
NEWS_MAX_HEADLINES=15
NEWS_DUPLICATE_SIMILARITY=0.8
NEWS_THIN_ARTICLES=3
SENTIMENT_NEUTRAL_BAND=0.15
BRAIN_MIN_ABS_SCORE=0.15
BRAIN_CONFLICT_MIN_CONFIDENCE=0.4
REQUEST_LOCK_TIMEOUT_MINUTES=30
LLM_SMALL_MODEL_CUTOFF=2024-06-30
LLM_LARGE_MODEL_CUTOFF=2024-06-30

# --- Pinned LLM models (D9 in dev-plan.md; don't change without an ADR) ---
LLM_SMALL_MODEL=openai/gpt-oss-20b
LLM_LARGE_MODEL=openai/gpt-oss-120b

# --- LLM gateway (M2) ----------------------------------------------------
LLM_REASONING_EFFORT_SMALL=low
LLM_REASONING_EFFORT_LARGE=low
LLM_RPM_LIMIT=30
LLM_TPM_LIMIT=8000
LLM_OUTPUT_ALLOWANCE_TOKENS=1869
LLM_DAILY_TOKEN_BUDGET=200000
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_TIMEOUT_SECONDS=60.0
LLM_SEED=1

# --- Journal (M2) ----------------------------------------------------------
JOURNAL_DB_PATH=journal.db

# --- Langfuse (optional, off by default; M2 D7) ---------------------------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Misc --------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10.0
